Question: 2nd largest number from array - code

using System.Linq;

public static int GetSecondLargestLinq(int[] arr)
{
    // Distinct() removes duplicates
    // OrderByDescending() puts the largest at the top
    // Skip(1) skips the first (largest) element
    // FirstOrDefault() grabs the next one
    return arr.Distinct().OrderByDescending(x => x).Skip(1).FirstOrDefault();
}

or

using System;

public static int GetSecondLargestBySorting(int[] arr)
{
    if (arr == null || arr.Length < 2)
        throw new ArgumentException("Need at least 2 elements");

    // Sort the array in ascending order (Smallest to Largest)
    Array.Sort(arr);

    // The largest is at arr.Length - 1
    // The second largest is at arr.Length - 2
    return arr[arr.Length - 2];
}

