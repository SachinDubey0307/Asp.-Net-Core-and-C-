question: Given a string input . Display the occurrence of each characters
    Input: "teams meeting"
  Output : t-2, e-3, a-1,m-2

Answer:
using System;
using System.Linq;

public class Program
{
    public static void Main()
    {
        string input = "teams meeting";
        
        var result = input.ToLower()
                          .Where(c => c != ' ') // Ignore spaces
                          .GroupBy(c => c)
                          .Select(g => $"{g.Key}-{g.Count()}");
                          
        Console.WriteLine(string.Join(", ", result));
    }
}














