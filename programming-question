Question: Reverse The Number
 internal class reverseTheNumber
 {
     int nsourceString, nreversedString;
         
     public void reversetheNumber()
     {
         Console.WriteLine("Enter a number to reverse: ");
         nsourceString = Convert.ToInt32(Console.ReadLine());
         while (nsourceString != 0) 
         {
             nreversedString = nreversedString * 10;
             nreversedString = nreversedString + nsourceString % 10;
             nsourceString = nsourceString / 10;
         }
         Console.WriteLine("the revese string result is:"+nreversedString);
     }
 }

